  < @RG\tID:rg1\tSM:sample1\tPL:ILLUMINA (esc)
  < soft_clip\t0\tchr1\t1\t30\t2S8M\t*\t0\t0\tNNACGTACGT\tIIIIIIIIII\tNM:i:0\tRG:Z:rg1 (esc)
  < insertion\t0\tchr1\t10\t30\t5M2I3M\t*\t0\t0\tACGTANNCGT\tIIIIIIIIII\tNM:i:2 (esc)
  < deletion\t0\tchr1\t20\t30\t5M3D5M\t*\t0\t0\tACGTAACGTA\tIIIIIIIIII\tNM:i:3 (esc)
  < skip\t0\tchr1\t50\t30\t3M100N3M\t*\t0\t0\tACGACG\tIIIIII\tNM:i:0\tXS:A:+ (esc)
  < hard_clip\t0\tchr1\t100\t30\t3H7M\t*\t0\t0\tACGTACG\tIIIIIII\tNM:i:0 (esc)
  < paired_r1\t99\tchr1\t200\t30\t10M\t=\t300\t110\tACGTACGTAC\tIIIIIIIIII\tNM:i:0\tRG:Z:rg1 (esc)
